{
  "name": "kabumon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync:monsters": "node scripts/sync-monster-assets.mjs",
    "generate:transparent-monsters": "node scripts/generate-transparent-monsters.mjs",
    "prepare:monsters": "npm run sync:monsters && npm run generate:transparent-monsters",
    "export:company-template": "node scripts/export-company-data-template.mjs",
    "preview:company-overrides": "node scripts/import-company-data-overrides.mjs --dry-run",
    "import:company-overrides": "node scripts/import-company-data-overrides.mjs",
    "test:company-overrides": "node scripts/test-company-overrides.mjs",
    "verify:company-data": "node scripts/verify-company-data.mjs",
    "verify": "npm run prepare:monsters && node scripts/verify-company-data.mjs && tsc --noEmit",
    "verify:ci": "npm run verify && git diff --exit-code",
    "predev": "npm run prepare:monsters",
    "dev": "next dev",
    "prebuild": "npm run prepare:monsters",
    "build": "next build",
    "prebuild:pages": "npm run prepare:monsters",
    "build:pages": "GITHUB_PAGES=true NEXT_PUBLIC_BASE_PATH=/kabumon1 next build",
    "postbuild:pages": "node scripts/prune-pages-assets.mjs",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "next": "^15.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
